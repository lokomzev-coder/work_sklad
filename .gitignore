# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Block O phase 8: locally-stored uploaded files (product images, document
# attachments) — never committed, same as any other user-generated content.
/storage/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings (personal, not shared with the team)
/.claude/settings.local.json

/src/generated/prisma

# playwright MCP browser tool artifacts (screenshots, console/network logs)
/.playwright-mcp/

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/
.swarm/

# playwright CLI browser tool artifacts (screenshots, console/network logs)
/.playwright-cli/

# Stray Python venvs (e.g. from a `strix-agent` install run inside the repo
# root instead of the user's global site-packages) — never belong in this
# Node.js project; excluded so git/eslint stop walking their vendored JS/pyd
# payloads.
/.venv/
/.venv-*/

