{
	# Caddy silently falls back to Let's Encrypt's STAGING CA after enough
	# repeated issuance failures (a courtesy to avoid burning the real
	# production rate limit while something else — DNS, port-forwarding —
	# is still being debugged, which is exactly what happened here). A
	# staging cert is NOT trusted by real browsers, so pin production
	# explicitly rather than relying on whichever one Caddy picked last.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$CADDY_DOMAIN}, www.{$CADDY_DOMAIN} {
	reverse_proxy app:3000

	header {
		# Belt-and-suspenders alongside next.config.ts's own nosniff header —
		# harmless to set twice, cheap insurance if the app header is ever
		# missing on an edge case (e.g. an error page Next renders itself).
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	encode zstd gzip
}
