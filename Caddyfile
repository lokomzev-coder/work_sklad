# Block T deploy, revision 2 (2026-09-15): the ISP puts this connection
# behind CGNAT (100.64.0.0/10 on the router's WAN side) — no port-forward
# on the router can ever be reached from the internet, confirmed live
# (Let's Encrypt's own HTTP-01/TLS-ALPN-01 challenges timed out connecting
# to the forwarded ports). Public TLS now terminates on a separate VPS
# relay instead (see deploy/vps-relay-setup.sh + deploy/frpc.toml) — this
# Caddy is a plain-HTTP internal hop reached only by the `frpc` service on
# the same docker network, which tunnels it out to the VPS. It no longer
# needs its own certificate or a published port at all.
:80 {
	reverse_proxy app:3000

	header {
		# Belt-and-suspenders alongside next.config.ts's own nosniff header —
		# harmless to set twice, cheap insurance if the app header is ever
		# missing on an edge case (e.g. an error page Next renders itself).
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	encode zstd gzip
}
