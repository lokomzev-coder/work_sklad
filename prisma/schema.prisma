// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships     Membership[]
  vaultGrantsMade EmployeeVaultAccess[]
  vaultAccessLogs VaultAccessLog[]
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  // per-org data-encryption-key for the password vault, wrapped by the app master key
  encDekWrapped Bytes?
  encDekNonce   Bytes?

  // Currency all money reports/balances convert into (Block H2). Amounts in
  // any other currency are converted via the latest applicable ExchangeRate.
  baseCurrency String @default("RUB")

  memberships            Membership[]
  employees              Employee[]
  clients                Client[]
  catalogItems           CatalogItem[]
  catalogGroups          CatalogGroup[]
  units                  Unit[]
  characteristics        Characteristic[]
  orders                 Order[]
  purchaseOrders         PurchaseOrder[]
  payments               Payment[]
  vaultEntries           VaultServiceEntry[]
  tags                   Tag[]
  stores                 Store[]
  stockMovements         StockMovement[]
  salesChannels          SalesChannel[]
  contracts              Contract[]
  legalEntities          LegalEntity[]
  documentStatuses       DocumentStatus[]
  customFieldDefinitions CustomFieldDefinition[]
  exchangeRates          ExchangeRate[]
  webhooks               Webhook[]
  customRoles            CustomRole[]
  techCards              TechCard[]
  productionOrders       ProductionOrder[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role
  // Sign-in identifier scoped to this org, МойСклад-style: shown/typed as
  // "login@orgSlug" (see lib/slug.ts for the org half). Unique only within
  // the org, not globally — the same physical person can have different
  // logins in different orgs. Password still lives on User (one password
  // per human across all their org memberships); only the identifier that
  // resolves *which* Membership/User to check it against is per-org.
  login  String

  // Links this login to an Employee record, so "who am I" for OWN-scope
  // permissions (Block I) resolves to a concrete assignedEmployeeId, and so
  // an Employee can be given self-service dashboard access. Optional — most
  // orgs will have Employee rows that never get a login at all.
  employeeId String?     @unique
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // Overrides the base enum `role` with a per-org custom permission matrix
  // (Block I) when set; falls back to the enum-based matrix when null.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@unique([orgId, login])
  @@index([orgId])
  @@index([customRoleId])
}

// Shared status for archivable entities (Employee, Client, CatalogItem, VaultServiceEntry).
enum EntityStatus {
  ACTIVE
  ARCHIVED
}

model Employee {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fullName   String
  position   String?
  email      String?
  phone      String?
  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())

  ordersAssigned           Order[]               @relation("AssignedEmployee")
  purchaseOrdersAssigned   PurchaseOrder[]       @relation("AssignedEmployeePO")
  productionOrdersAssigned ProductionOrder[]     @relation("AssignedEmployeeProduction")
  vaultAccess              EmployeeVaultAccess[]
  // Opposite side of Membership.employeeId — set only if this employee has
  // been granted a personal login (Block I self-service).
  membership               Membership?

  @@index([orgId, status])
}

model Client {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  inn        String?
  phone      String?
  email      String?
  address    String?
  // Legal/banking requisites (D4) — optional, only meaningful for
  // organization counterparties, not individuals.
  kpp        String?
  ogrn       String?
  bankName   String?
  bankBik    String?
  bankAccount String?
  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())

  orders         Order[]
  purchaseOrders PurchaseOrder[] @relation("Supplier")
  payments       Payment[]
  contacts       ClientContact[]
  addresses      ClientAddress[]
  contracts      Contract[]

  @@index([orgId, status])
}

// Additional contact persons for a Client (D4) — a counterparty commonly has
// more than one person you deal with (accountant, purchasing manager...).
model ClientContact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  position String?
  phone    String?
  email    String?

  @@index([clientId])
}

// Multiple addresses per Client (D4 follow-up) — same reasoning as
// ClientContact: a counterparty commonly has more than one address (legal,
// warehouse, delivery...). `label` is a free-text tag (e.g. "Юридический"),
// not an enum — orgs describe these differently.
model ClientAddress {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label    String?
  address  String

  @@index([clientId])
}

// A contract governing one or more orders/purchase orders with a
// counterparty (D2) — deliberately minimal (just a reference + optional
// number/date), not a document-management system.
model Contract {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  number    String
  signedAt  DateTime?
  createdAt DateTime     @default(now())

  orders         Order[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId])
  @@index([clientId])
}

// Sales channel tag on an Order (D3) — e.g. "Розница"/"Опт"/"Маркетплейс",
// for reporting only, no behavioural difference between channels yet.
model SalesChannel {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String

  orders Order[]

  @@unique([orgId, name])
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  BUNDLE
}

// Reference dictionary of measurement units (шт, кг, м² и т.д.), scoped per
// organization so each org can maintain its own list. Never archived — if a
// unit is referenced by a CatalogItem, deletion is blocked in the action
// layer (and backstopped by onDelete: Restrict below).
model Unit {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  shortName String
  createdAt DateTime @default(now())

  catalogItems CatalogItem[]

  @@unique([orgId, name])
  @@index([orgId])
}

// Hierarchical product-group folders (МойСклад's productFolder). Also never
// archived — deletion is blocked in the action layer if it still holds
// subgroups or catalog items.
model CatalogGroup {
  id       String  @id @default(cuid())
  orgId    String
  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name     String
  parentId String?
  parent   CatalogGroup?  @relation("CatalogGroupChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children CatalogGroup[] @relation("CatalogGroupChildren")

  catalogItems CatalogItem[]

  @@index([orgId, parentId])
}

model CatalogItem {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  type       CatalogItemType
  sku        String?
  barcode    String?
  unitPrice  Decimal         @db.Decimal(12, 2)
  currency   String          @default("RUB")
  unitId     String?
  unit       Unit?           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  groupId    String?
  group      CatalogGroup?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  status     EntityStatus    @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())

  lineItems              OrderLineItem[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  bundleComponents       CatalogItemComponent[] @relation("BundleComponents")
  partOfBundles          CatalogItemComponent[] @relation("ComponentOfBundles")
  stockMovementLines     StockMovementLine[]
  variants               CatalogItemVariant[]
  techCardOutputs        TechCard[]              @relation("TechCardOutput")
  techCardComponentOf    TechCardComponent[]     @relation("TechCardComponentItem")

  @@index([orgId, status])
  @@index([orgId, groupId])
}

// A characteristic dictionary (e.g. "Размер", "Цвет") — org-scoped, reused
// across variants of different products, same pattern as Unit/CatalogGroup.
model Characteristic {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String

  values CatalogItemVariantValue[]

  @@unique([orgId, name])
}

// A modification of a PRODUCT-type CatalogItem (e.g. "Стул, размер L,
// цвет красный") — own SKU/barcode/optional price override. Deliberately
// scoped WITHOUT its own stock ledger for this pass: stock is still tracked
// only at the base CatalogItem level (see lib/stock.ts) — variant-level
// stock granularity is a real follow-up, not implemented yet, to avoid
// reworking the ledger and every fulfilment flow in the same change.
model CatalogItemVariant {
  id            String       @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  sku           String?
  barcode       String?
  priceOverride Decimal?     @db.Decimal(12, 2)
  status        EntityStatus @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())

  values    CatalogItemVariantValue[]
  lineItems OrderLineItem[]

  @@index([catalogItemId, status])
}

model CatalogItemVariantValue {
  id               String             @id @default(cuid())
  variantId        String
  variant          CatalogItemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  characteristicId String
  characteristic   Characteristic     @relation(fields: [characteristicId], references: [id], onDelete: Restrict)
  value            String

  @@unique([variantId, characteristicId])
}

// A BUNDLE-type CatalogItem is composed of other (non-bundle) catalog items
// sold together at the bundle's own fixed price — МойСклад's `bundle`. No
// nested bundles: a component's type must not be BUNDLE (enforced in
// actions/catalog-bundles.ts, since Prisma can't express that constraint).
model CatalogItemComponent {
  id          String      @id @default(cuid())
  bundleId    String
  bundle      CatalogItem @relation("BundleComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId String
  component   CatalogItem @relation("ComponentOfBundles", fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Decimal     @db.Decimal(12, 3)

  @@unique([bundleId, componentId])
  @@index([bundleId])
}

// --- Warehouses & stock -------------------------------------------------
// Stock is never stored as a mutable balance — it's always derived from the
// StockMovementLine ledger (see lib/stock.ts), so it can't drift out of sync
// with its own history. ENTER/INVENTORY lines add `quantity` to storeId,
// LOSS/MOVE subtract it from storeId; MOVE additionally adds it to toStoreId.
// For INVENTORY, `quantity` is the signed delta (counted - system balance at
// posting time), computed server-side; `countedQuantity` keeps the raw
// count the user entered, for display only.

model Store {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())

  movementsAsSource      StockMovement[] @relation("SourceStore")
  movementsAsDestination StockMovement[] @relation("DestinationStore")
  productionOrders       ProductionOrder[]

  @@index([orgId, status])
}

// DEMAND (отгрузка) and SUPPLY (приёмка) are the document-driven counterparts
// of LOSS/ENTER: DEMAND fulfils a customer Order and subtracts stock like
// LOSS; SUPPLY fulfils a PurchaseOrder and adds stock like ENTER.
// SALES_RETURN/PURCHASE_RETURN are their mirror images: a client returning
// goods behaves like ENTER (capped by how much was actually demanded and not
// yet returned), a return to a supplier behaves like LOSS (capped by how
// much was actually supplied and not yet returned). PRODUCTION_CONSUME/
// PRODUCTION_OUTPUT (Block F) are the same idea for a ProductionOrder: raw
// materials are consumed like LOSS, the finished good is produced like
// ENTER — posted together, atomically, by actions/production-orders.ts::
// completeProductionOrder. Routing all of this through one ledger (rather
// than separate mechanisms) means lib/stock.ts never needs to know about
// Orders/PurchaseOrders/ProductionOrders at all — it only ever reasons about
// the CASE below.
enum StockMovementType {
  ENTER
  LOSS
  MOVE
  INVENTORY
  DEMAND
  SUPPLY
  SALES_RETURN
  PURCHASE_RETURN
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
}

// Movements are immutable once created — a mistake is corrected with another
// (reversing) movement, not by editing history, same principle as ledger
// entries in accounting systems.
model StockMovement {
  id              String            @id @default(cuid())
  orgId           String
  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type            StockMovementType
  number          Int
  storeId         String
  store           Store             @relation("SourceStore", fields: [storeId], references: [id], onDelete: Restrict)
  toStoreId       String?
  toStore         Store?            @relation("DestinationStore", fields: [toStoreId], references: [id], onDelete: Restrict)
  comment         String?
  createdAt       DateTime          @default(now())
  // Only set for type = DEMAND / SUPPLY / PRODUCTION_CONSUME|OUTPUT
  // respectively — the document this movement fulfils, for traceability
  // ("which shipments came out of this order?").
  orderId         String?
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  lines StockMovementLine[]

  @@unique([orgId, number])
  @@index([orgId, type])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([productionOrderId])
}

model StockMovementLine {
  id                String        @id @default(cuid())
  movementId        String
  movement          StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  catalogItemId     String
  catalogItem       CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  quantity          Decimal       @db.Decimal(12, 3)
  countedQuantity   Decimal?      @db.Decimal(12, 3)
  // Sale price (DEMAND) or purchase cost (SUPPLY) snapshotted at posting
  // time — same reasoning as OrderLineItem.unitPriceSnapshot: later catalog
  // price edits must not retroactively change historical documents.
  unitPriceSnapshot Decimal?      @db.Decimal(12, 2)
  // Currency of unitPriceSnapshot (Block H2), carried over from the
  // order/PO line being fulfilled. Null wherever unitPriceSnapshot is null
  // (ENTER/LOSS/MOVE/INVENTORY have no price at all).
  currency          String?

  @@index([movementId])
  @@index([catalogItemId])
}

// Company's own legal entity issuing a document (D1) — distinct from the
// tenant Organization (which is the SaaS account) and from Client (the
// counterparty). Most orgs need exactly one; the model still allows several
// for the rare company with more than one legal entity, without forcing
// everyone through that complexity (`isDefault` picks who's pre-selected on
// new documents).
model LegalEntity {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  inn         String?
  kpp         String?
  ogrn        String?
  address     String?
  bankName    String?
  bankBik     String?
  bankAccount String?
  isDefault   Boolean      @default(false)
  status      EntityStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())

  orders         Order[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId, status])
}

// C4: per-org configurable statuses, replacing the old hardcoded
// OrderStatus/PurchaseOrderStatus enums — a named, ordered, colored list per
// document kind, which is what actually varies between businesses ("Ожидает
// оплаты", "В сборке", ...). Every org gets 4 seeded defaults
// (lib/document-statuses.ts::ensureDefaultStatuses, same lazy-backfill
// pattern as the vault DEK) mirroring the old enum, so existing behavior is
// preserved unless the org customizes it.
enum DocumentStatusKind {
  ORDER
  PURCHASE_ORDER
  PRODUCTION_ORDER
}

model DocumentStatus {
  id        String             @id @default(cuid())
  orgId     String
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      DocumentStatusKind
  name      String
  color     String             @default("gray")
  position  Int
  // A document in a final status is done (won't naturally progress further)
  // — used only for display emphasis, not enforced.
  isFinal   Boolean            @default(false)
  createdAt DateTime           @default(now())

  orders           Order[]
  purchaseOrders   PurchaseOrder[]
  productionOrders ProductionOrder[]
  transitionsOut   DocumentStatusTransition[] @relation("TransitionFrom")
  transitionsIn    DocumentStatusTransition[] @relation("TransitionTo")

  @@unique([orgId, kind, name])
  @@index([orgId, kind, position])
}

// C4 follow-up: opt-in transition graph on top of DocumentStatus. A status
// with ZERO outgoing rows here is unrestricted (can move to any other status
// of the same kind) — this is the pre-existing/default behavior, so orgs
// that never touch this stay exactly as before. The moment an org adds even
// one transition row FROM a given status, that status becomes restricted:
// only the explicitly listed destinations are allowed from then on. Empty
// `allowedRoles` means "any role that already has orders:edit" (no further
// restriction); a non-empty list narrows it to those roles specifically —
// this is an ADDITIONAL check on top of, not a replacement for, the base
// role/scope checks in actions/orders.ts and actions/purchase-orders.ts.
model DocumentStatusTransition {
  id           String         @id @default(cuid())
  fromStatusId String
  fromStatus   DocumentStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId   String
  toStatus     DocumentStatus @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  allowedRoles Role[]         @default([])
  // Same "who can" idea as allowedRoles, but at CustomRole/Employee
  // granularity (МойСклад studied 2026-08-29: their business-process editor
  // lets you name individual employees or roles for a transition, not just
  // the base role). All three arrays are OR'd together: empty across all
  // three means unrestricted (same as before); any non-empty array narrows
  // to a union of what it lists. IDs aren't FK-constrained here (an org can
  // delete a CustomRole/Employee later) — stale IDs just stop matching
  // anyone, same failure mode as a since-deleted role would have anyway.
  allowedCustomRoleIds String[] @default([])
  allowedEmployeeIds   String[] @default([])

  @@unique([fromStatusId, toStatusId])
  @@index([fromStatusId])
}

// --- Production (Block F) -----------------------------------------------
// A TechCard is a bill-of-materials: it names a finished PRODUCT
// (outputItem, produced in batches of outputQuantity) and the raw-material
// PRODUCTs consumed to make one batch. Deliberately reuses the same
// PRODUCT-only restriction as fulfillment.ts (services/bundles don't carry
// real stock) and the same "delete+recreate on every save" component-list
// pattern as CatalogItemComponent/actions/catalog-bundles.ts — this is not
// a sales kit (nothing here is virtual/assembled-on-demand), it's a real
// atomic stock conversion posted by ProductionOrder.
model TechCard {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  outputItemId   String
  outputItem     CatalogItem  @relation("TechCardOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  outputQuantity Decimal      @db.Decimal(12, 3)
  status         EntityStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  components       TechCardComponent[]
  productionOrders ProductionOrder[]

  @@index([orgId, status])
}

model TechCardComponent {
  id            String      @id @default(cuid())
  techCardId    String
  techCard      TechCard    @relation(fields: [techCardId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem @relation("TechCardComponentItem", fields: [catalogItemId], references: [id], onDelete: Restrict)
  // Quantity needed per one outputQuantity batch of the parent TechCard —
  // actual consumption on a ProductionOrder scales this by
  // (order.quantity / techCard.outputQuantity).
  quantity      Decimal     @db.Decimal(12, 3)

  @@unique([techCardId, catalogItemId])
}

// A production run: "make `quantity` units of techCard.outputItem". Status
// is a normal DocumentStatus workflow (Block C4/K, purely descriptive), kept
// deliberately independent of stock — the actual atomic consume+produce
// ledger posting happens once, via completeProductionOrder, guarded by
// completedAt so it can never double-post.
model ProductionOrder {
  id                 String         @id @default(cuid())
  orgId              String
  org                Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number             Int
  techCardId         String
  techCard           TechCard       @relation(fields: [techCardId], references: [id], onDelete: Restrict)
  storeId            String
  store              Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  quantity           Decimal        @db.Decimal(12, 3)
  assignedEmployeeId String?
  assignedEmployee   Employee?      @relation("AssignedEmployeeProduction", fields: [assignedEmployeeId], references: [id])
  statusId           String
  status             DocumentStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())

  stockMovements StockMovement[]

  @@unique([orgId, number])
  @@index([orgId, statusId])
}

model Order {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number             Int
  clientId           String?
  client             Client?      @relation(fields: [clientId], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee?    @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  contractId         String?
  contract           Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  salesChannelId     String?
  salesChannel       SalesChannel? @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  legalEntityId      String?
  legalEntity        LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  statusId           String
  status             DocumentStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())

  lineItems OrderLineItem[]
  demands   StockMovement[]
  payments  Payment[]

  @@unique([orgId, number])
  @@index([orgId, statusId])
}

model OrderLineItem {
  id                String              @id @default(cuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId     String
  catalogItem       CatalogItem         @relation(fields: [catalogItemId], references: [id])
  variantId         String?
  variant           CatalogItemVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Decimal             @db.Decimal(12, 3)
  unitPriceSnapshot Decimal             @db.Decimal(12, 2)
  // Snapshotted alongside the price (Block H2) — a later change to the
  // catalog item's currency must not retroactively change this line.
  currency          String              @default("RUB")

  @@index([orderId])
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  orgId              String
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number             Int
  supplierId         String?
  supplier           Client?             @relation("Supplier", fields: [supplierId], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee?           @relation("AssignedEmployeePO", fields: [assignedEmployeeId], references: [id])
  contractId         String?
  contract           Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  legalEntityId      String?
  legalEntity        LegalEntity?        @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  statusId           String
  status             DocumentStatus      @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())

  lineItems PurchaseOrderLineItem[]
  supplies  StockMovement[]
  payments  Payment[]

  @@unique([orgId, number])
  @@index([orgId, statusId])
}

model PurchaseOrderLineItem {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  catalogItemId     String
  catalogItem       CatalogItem   @relation(fields: [catalogItemId], references: [id])
  quantity          Decimal       @db.Decimal(12, 3)
  unitPriceSnapshot Decimal       @db.Decimal(12, 2)
  currency          String        @default("RUB")

  @@index([purchaseOrderId])
}

enum PaymentDirection {
  IN
  OUT
}

// A minimal money ledger — enough to answer "who owes us / who do we owe"
// (lib/balances.ts) without modeling full invoices yet (ROADMAP Block C3
// still needs InvoiceIn/InvoiceOut/Prepayment as a separate follow-up).
model Payment {
  id              String           @id @default(cuid())
  orgId           String
  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  direction       PaymentDirection
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("RUB")
  counterpartyId  String
  counterparty    Client           @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  comment         String?
  createdAt       DateTime         @default(now())

  @@index([orgId])
  @@index([counterpartyId])
}

// --- Password vault ---------------------------------------------------
// Secrets are encrypted with AES-256-GCM using the organization's DEK
// (Organization.encDekWrapped, unwrapped via lib/org-dek.ts). Plaintext
// only ever exists transiently in a Server Action's memory, never at rest,
// never in a client bundle, never logged.

model VaultServiceEntry {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceName String
  url         String?
  username    String?
  ciphertext  Bytes
  nonce       Bytes
  authTag     Bytes
  notes       String?
  status      EntityStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  accessGrants EmployeeVaultAccess[]
  tags         TagOnVaultEntry[]
  accessLogs   VaultAccessLog[]

  @@index([orgId, status])
}

model EmployeeVaultAccess {
  id           String            @id @default(cuid())
  employeeId   String
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vaultEntryId String
  vaultEntry   VaultServiceEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  grantedAt    DateTime          @default(now())
  grantedById  String?
  grantedBy    User?             @relation(fields: [grantedById], references: [id])

  @@unique([employeeId, vaultEntryId])
  @@index([vaultEntryId])
}

enum TagKind {
  MANUAL
  EMPLOYEE_ACCESS
}

model Tag {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  kind             TagKind      @default(MANUAL)
  sourceEmployeeId String?

  vaultEntries TagOnVaultEntry[]

  @@unique([orgId, name])
}

model TagOnVaultEntry {
  tagId        String
  vaultEntryId String
  tag          Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)
  vaultEntry   VaultServiceEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)

  @@id([tagId, vaultEntryId])
}

model VaultAccessLog {
  id           String            @id @default(cuid())
  vaultEntryId String
  vaultEntry   VaultServiceEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  action       String
  createdAt    DateTime          @default(now())

  @@index([vaultEntryId])
}

// --- Block H3: custom fields --------------------------------------------
// Generic EAV pattern scoped to the entities that actually benefit from
// ad-hoc fields (dictionaries/documents users edit by hand). No FK from
// CustomFieldValue.entityId to the target row — Prisma can't express a
// polymorphic relation — so a hard-deleted Client/CatalogItem can leave
// orphaned values behind; archiveOrDelete's hard-delete branches clean these
// up explicitly (see lib/archive.ts) to keep that window small. Order/
// PurchaseOrder are never hard-deleted at all, so no cleanup needed there.

enum CustomFieldEntityType {
  CLIENT
  CATALOG_ITEM
  ORDER
  PURCHASE_ORDER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id         String                @id @default(cuid())
  orgId      String
  org        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType CustomFieldEntityType
  name       String
  type       CustomFieldType
  // Selectable values when type = SELECT; unused otherwise.
  options    String[]              @default([])
  position   Int                   @default(0)
  createdAt  DateTime              @default(now())

  values CustomFieldValue[]

  @@unique([orgId, entityType, name])
  @@index([orgId, entityType])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityId     String
  // Everything stored as text regardless of `type` (NUMBER/DATE/BOOLEAN are
  // parsed back on read) — avoids a wide sparse-column table for 4 rarely-
  // mixed value shapes.
  value        String?

  @@unique([definitionId, entityId])
  @@index([entityId])
}

// --- Block H2: multi-currency --------------------------------------------
// One rate per (org, currency, effective date) — "how many units of
// Organization.baseCurrency for 1 unit of `currency`". Converting an amount
// looks up the latest rate with effectiveAt <= the amount's own date (falls
// back to the latest rate overall if the amount predates every recorded
// rate). No historical FX table/provider integration — rates are entered by
// hand, same spirit as everything else in this MVP.
model ExchangeRate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  currency    String
  rateToBase  Decimal      @db.Decimal(14, 6)
  effectiveAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, currency, effectiveAt])
}

// --- Block H4: webhooks ---------------------------------------------------
// Best-effort outbound notifications for external integrations (1С, sites,
// marketplaces) — fire-and-forget HTTP POST with an HMAC-SHA256 signature
// over the raw body (header X-EasyWork-Signature), no retry queue (no
// background-job infra exists yet in this project) — a failed delivery is
// just logged to WebhookDelivery for the user to notice and re-trigger
// manually if needed.
enum WebhookEvent {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_STATUS_CHANGED
  PAYMENT_CREATED
}

model Webhook {
  id        String         @id @default(cuid())
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    WebhookEvent[]
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id         String       @id @default(cuid())
  webhookId  String
  webhook    Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      WebhookEvent
  statusCode Int?
  success    Boolean
  error      String?
  createdAt  DateTime     @default(now())

  @@index([webhookId, createdAt])
}

// --- Block I: flexible permissions ----------------------------------------
// A per-org reusable role (МойСклад's customrole) whose `permissions` JSON
// fully REPLACES the enum-based matrix in lib/permissions.ts for any
// Membership it's assigned to (not merged with the base Role) — see
// notes/ROADMAP.md Block I. Scoped down from the researched МойСклад model:
// only `ALL | OWN` (no OWN_GROUP — no department/group entity exists yet)
// and only meaningful for the "orders" resource (assignedEmployeeId is the
// only resource with a natural per-employee owner right now).
model CustomRole {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  // Record<Resource, { access: Access; scope?: "ALL" | "OWN" }> — see
  // lib/permissions.ts for the shape this is parsed into.
  permissions Json
  createdAt   DateTime @default(now())

  memberships Membership[]

  @@unique([orgId, name])
}
